{
  "manifestVersion": 5,
  "id": "a0699c84",
  "name": "Thai AI Proofreader",
  "version": "1.3.1",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "18.5.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "clipboard": "readAndWrite",
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": ["https", "http", "file"],
        "extensions": []
    }
  },
  "entrypoints": [
    {
      "id": "mainPanel",
      "type": "panel",
      "label": {
        "default": "Thai AI Proofreader"
      },
      "minimumSize": {
        "width": 350,
        "height": 400
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 350,
        "height": 700
      },
      "preferredFloatingSize": {
        "width": 350,
        "height": 700
      },
      "icons": [
        {
          "path": "icons/plugin.png",
          "width": 23,
          "height": 23,
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium",
            "lightest",
            "light",
            "all"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "path": "icons/plugin.png",
      "width": 48,
      "height": 48,
      "species": [
        "pluginList"
      ],
      "scale": [
        1,
        2
      ],
      "theme": [
        "darkest",
        "dark",
        "medium",
        "lightest",
        "light",
        "all"
      ]
    }
  ]
}