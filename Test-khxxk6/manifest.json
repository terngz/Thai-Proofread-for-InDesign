{
  "manifestVersion": 5,
  "id": "com.thai.proofread.indesign",
  "name": "Thai AI Proofreader TH/EN",
  "version": "1.0.1",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "18.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": "all"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": {
        "default": "Thai AI Proofreader Panel"
      },
      "minimumSize": {
        "width": 240,
        "height": 160
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 320
      },
      "preferredFloatingSize": {
        "width": 500,
        "height": 360
      }
    }
  ]
}
